# Supabase project (Dashboard > Project Settings > API). Used by the public site AND the admin at /admin.
# Copy this file to .env.local and fill in your own project's values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "anon" / publishable key. Safe to expose in the browser: every table is protected by row level security
# and only active admin profiles may write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: email staff about every enquiry (https://resend.com). If the database save fails, the email is the backup.
RESEND_API_KEY=
# Comma-separated staff addresses that receive enquiry emails.
LEAD_NOTIFY_EMAIL=
# Sender, from a domain verified in Resend, e.g. "Parmar Leads <leads@parmarproperties.in>".
LEAD_FROM_EMAIL=
# Any random string. Used to hash visitor IPs for enquiry rate limiting (raw IPs are never stored).
LEAD_IP_SALT=
